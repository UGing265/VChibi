<Window x:Class="VChibi.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:VChibi.ViewModels"
        xmlns:controls="clr-namespace:VChibi.Controls"
        xmlns:views="clr-namespace:VChibi.Views"
        mc:Ignorable="d"
        Title="VChibi"
        Width="920"
        Height="580"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="Auto" />
            <!-- Corruption warning banner -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Status footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E8E4F0"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource LavenderAccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="✦" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="VChibi" Style="{StaticResource AppHeaderTextStyle}" />
                        <TextBlock Text="Desktop Idol Pet" FontSize="11" Foreground="#7A757F" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEditorOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button x:Name="ImportPackageButton"
                            AutomationProperties.AutomationId="ImportPackageButton"
                            Content="Import gói"
                            Command="{Binding ImportPackageCommand}"
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Background="#F0EEF8"
                            Foreground="#7862B8"
                            BorderBrush="{StaticResource LavenderAccentBorderBrush}"
                            BorderThickness="1"
                            FontWeight="Medium"
                            Cursor="Hand" />
                    <Button x:Name="CreatePetButton"
                            AutomationProperties.AutomationId="CreatePetButton"
                            Content="+ Tạo pet"
                            Command="{Binding OpenCreatePetCommand}"
                            Padding="14,6"
                            Style="{StaticResource LavenderPrimaryButtonStyle}"
                            Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Corruption Warning Banner -->
        <Border Grid.Row="1"
                Background="#FFF0F0"
                BorderBrush="#FFCDD2"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                Visibility="{Binding IsSettingsCorrupted, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="⚠ Tệp cài đặt settings.json bị lỗi" FontWeight="Bold" Foreground="#BA1A1A" />
                    <TextBlock Text="{Binding CorruptionErrorMessage}" FontSize="11" Foreground="#7A1B1B" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Đặt lại mặc định"
                            x:Name="ResetSettingsButton"
                            AutomationProperties.AutomationId="ResetSettingsButton"
                            Command="{Binding ResetSettingsCommand}"
                            Padding="12,4"
                            Margin="0,0,8,0"
                            Background="#BA1A1A"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand" />
                    <Button Content="Thoát không lưu"
                            x:Name="CancelSettingsRecoveryButton"
                            AutomationProperties.AutomationId="CancelSettingsRecoveryButton"
                            Command="{Binding CancelSettingsRecoveryCommand}"
                            Padding="12,4"
                            Background="Transparent"
                            Foreground="#BA1A1A"
                            BorderBrush="#BA1A1A"
                            BorderThickness="1"
                            Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body Area: switches between Library Grid and PetEditorView -->
        <Grid Grid.Row="2">
            <!-- 3-Column Library Grid -->
            <Grid Margin="16" Visibility="{Binding IsEditorOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Pet Library List -->
                    <ColumnDefinition Width="270" />
                    <!-- Col 1: Preview Area -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 2: Settings & Actions -->
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

            <!-- Column 0: Library -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E8E4F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="THƯ VIỆN PET"
                               Style="{StaticResource AppSubheaderTextStyle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#7862B8"
                               Margin="0,0,0,10" />

                    <!-- Pet List -->
                    <ListBox x:Name="PetListBox"
                             AutomationProperties.AutomationId="PetListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding Pets}"
                             SelectedItem="{Binding SelectedPet, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    BorderBrush="#E8E4F0"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F0EEF8" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource LavenderAccentBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8F7FC" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="4"
                                            Background="#F6F4FA"
                                            BorderBrush="#E4DEF0"
                                            BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>

                                    <!-- Pet Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontWeight="Medium"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Active Badge -->
                                    <Border Grid.Column="2"
                                            Background="{StaticResource LavenderAccentBrush}"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="✦ Đang chạy" FontSize="10" Foreground="#FFFFFF" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Column 1: Preview Area -->
            <Border Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="#E8E4F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Controls Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="XEM TRƯỚC"
                                   Style="{StaticResource AppSubheaderTextStyle}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#7862B8" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="IdleActionRadio" Content="Đứng" IsChecked="True" GroupName="PreviewAction" Checked="OnPreviewActionChecked" Margin="0,0,12,0" />
                            <RadioButton x:Name="WalkActionRadio" Content="Đi" GroupName="PreviewAction" Checked="OnPreviewActionChecked" />
                        </StackPanel>
                    </Grid>

                    <!-- Preview Stage -->
                    <Border Grid.Row="1"
                            Background="#F6F4FA"
                            BorderBrush="#E4DEF0"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <controls:SpritePreview x:Name="PetPreview" />
                    </Border>

                    <!-- Preview Footer Info -->
                    <TextBlock Grid.Row="2"
                               Text="Động tác hiển thị với tốc độ FPS đã thiết lập"
                               FontSize="11"
                               Foreground="#8C8696"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Column 2: Details & Settings -->
            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#E8E4F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="CÀI ĐẶT PET"
                               Style="{StaticResource AppSubheaderTextStyle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#7862B8"
                               Margin="0,0,0,12" />

                    <!-- Sliders & Info -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Pet Name -->
                            <TextBlock Text="{Binding SelectedPet.Name, FallbackValue='(Chưa chọn)'}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#1D1B20"
                                       Margin="0,0,0,14" />

                            <!-- Scale Slider -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Kích thước (Scale)" FontSize="12" Foreground="#49454F" />
                                <TextBlock Text="{Binding ScalePercent, StringFormat={}{0:F0}%}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource LavenderAccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="ScaleSlider"
                                    AutomationProperties.AutomationId="ScaleSlider"
                                    Minimum="25" Maximum="400" SmallChange="5" LargeChange="25" Value="{Binding ScalePercent, Mode=TwoWay}" Margin="0,0,0,16" />

                            <!-- Speed Slider -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Tốc độ di chuyển" FontSize="12" Foreground="#49454F" />
                                <TextBlock Text="{Binding MovementSpeed, StringFormat={}{0:F0} DIP/s}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource LavenderAccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SpeedSlider"
                                    AutomationProperties.AutomationId="SpeedSlider"
                                    Minimum="5" Maximum="200" SmallChange="5" LargeChange="20" Value="{Binding MovementSpeed, Mode=TwoWay}" Margin="0,0,0,20" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2">
                        <Button x:Name="EditPetButton"
                                AutomationProperties.AutomationId="EditPetButton"
                                Content="Chỉnh sửa pet"
                                Command="{Binding OpenEditPetCommand}"
                                Margin="0,0,0,8"
                                Padding="12,7"
                                Background="#F0EEF8"
                                Foreground="#7862B8"
                                BorderBrush="{StaticResource LavenderAccentBorderBrush}"
                                BorderThickness="1"
                                FontWeight="Medium"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand" />
                        <Button x:Name="ReleaseToDesktopButton"
                                AutomationProperties.AutomationId="ReleaseToDesktopButton"
                                Content="Thả ra desktop"
                                Command="{Binding ReleaseToDesktopCommand}"
                                Style="{StaticResource LavenderPrimaryButtonStyle}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch" />
                        <Button x:Name="HideFromDesktopButton"
                                AutomationProperties.AutomationId="HideFromDesktopButton"
                                Content="Ẩn khỏi desktop"
                                Command="{Binding HideFromDesktopCommand}"
                                Margin="0,0,0,8"
                                Padding="12,7"
                                Background="#F0EEF8"
                                Foreground="#7862B8"
                                BorderBrush="{StaticResource LavenderAccentBorderBrush}"
                                BorderThickness="1"
                                FontWeight="Medium"
                                HorizontalAlignment="Stretch" />
                        <Button x:Name="ExitButton"
                                AutomationProperties.AutomationId="ExitButton"
                                Content="Thoát"
                                Command="{Binding ExitCommand}"
                                Padding="12,6"
                                Background="Transparent"
                                Foreground="#BA1A1A"
                                BorderBrush="#E8E4F0"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>

            <!-- Pet Editor View -->
            <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:PetEditorView DataContext="{Binding Editor}" />
            </Grid>
        </Grid>

        <!-- Footer / Status Bar -->
        <Border Grid.Row="3"
                Background="#F4F2F8"
                BorderBrush="#E8E4F0"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <TextBlock x:Name="StatusBarTextBlock"
                           AutomationProperties.AutomationId="StatusBarTextBlock"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="#605D68"
                           VerticalAlignment="Center" />
                <TextBlock Text="VChibi v1.0.0"
                           FontSize="11"
                           Foreground="#8C8696"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
