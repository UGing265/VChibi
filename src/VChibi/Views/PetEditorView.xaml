<UserControl x:Class="VChibi.Views.PetEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:VChibi.ViewModels"
             xmlns:controls="clr-namespace:VChibi.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="850">
    <Grid Background="#F8F8FA">
        <Grid.RowDefinitions>
            <!-- Top bar -->
            <RowDefinition Height="Auto" />
            <!-- Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: Back & Title -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E8E4F0"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelEditorButton"
                        AutomationProperties.AutomationId="CancelEditorButton"
                        Command="{Binding CancelCommand}"
                        Content="← Quay lại thư viện"
                        Padding="10,5"
                        Background="#F0EEF8"
                        Foreground="#7862B8"
                        BorderBrush="{StaticResource LavenderAccentBorderBrush}"
                        BorderThickness="1"
                        FontWeight="Medium"
                        Cursor="Hand" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Name, StringFormat='{}Chỉnh sửa: {0}', FallbackValue='Tạo pet mới'}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#1C1B1F"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- Main Body: 2 Columns -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Pet details & Actions -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E8E4F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Pet Name -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="TÊN PET"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#7862B8"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="PetNameTextBox"
                                 AutomationProperties.AutomationId="PetNameTextBox"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,6"
                                 FontSize="13"
                                 BorderBrush="#D5CFE6"
                                 BorderThickness="1" />
                    </StackPanel>

                    <!-- Action Selector Tabs (Idle / Walk) -->
                    <Border Grid.Row="1"
                            Background="#F4F2F8"
                            CornerRadius="6"
                            Padding="4"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0"
                                         x:Name="IdleTabRadio"
                                         AutomationProperties.AutomationId="IdleTabRadio"
                                         IsChecked="{Binding IsIdleSelected, Mode=TwoWay}"
                                         Command="{Binding SelectActionCommand}"
                                         CommandParameter="idle"
                                         GroupName="EditorActionTabs"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"
                                         Cursor="Hand">
                                <TextBlock Text="{Binding IdleFrames.Count, StringFormat='{}Đứng (Idle) — {0} frames'}" />
                            </RadioButton>

                            <RadioButton Grid.Column="1"
                                         x:Name="WalkTabRadio"
                                         AutomationProperties.AutomationId="WalkTabRadio"
                                         IsChecked="{Binding IsWalkSelected, Mode=TwoWay}"
                                         Command="{Binding SelectActionCommand}"
                                         CommandParameter="walk"
                                         GroupName="EditorActionTabs"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"
                                         Cursor="Hand">
                                <TextBlock Text="{Binding WalkFrames.Count, StringFormat='{}Đi (Walk) — {0} frames'}" />
                            </RadioButton>
                        </Grid>
                    </Border>

                    <!-- Frame List Area -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Add Frames Button & Info -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Button x:Name="AddFramesButton"
                                    AutomationProperties.AutomationId="AddFramesButton"
                                    Command="{Binding AddFramesCommand}"
                                    Content="+ Thêm ảnh PNG..."
                                    Padding="12,5"
                                    Background="#7862B8"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    FontWeight="Medium"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand" />

                            <TextBlock Text="{Binding CurrentFrames.Count, StringFormat='{}Tổng số: {0} frames'}"
                                       FontSize="11"
                                       Foreground="#8C8696"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Frames ListBox -->
                        <Border Grid.Row="1"
                                Background="#FAF9FC"
                                BorderBrush="#E4DEF0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6">
                            <ListBox x:Name="FramesListBox"
                                     AutomationProperties.AutomationId="FramesListBox"
                                     ItemsSource="{Binding CurrentFrames}"
                                     SelectedItem="{Binding SelectedFrame, Mode=TwoWay}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="Margin" Value="2,0" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="FrameBorder"
                                                            Background="#FFFFFF"
                                                            BorderBrush="#E8E4F0"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="FrameBorder" Property="Background" Value="#F0EEF8" />
                                                            <Setter TargetName="FrameBorder" Property="BorderBrush" Value="{StaticResource LavenderAccentBorderBrush}" />
                                                            <Setter TargetName="FrameBorder" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="68" HorizontalAlignment="Center">
                                            <Border Width="56" Height="56"
                                                    CornerRadius="4"
                                                    Background="#F0EEF8"
                                                    BorderBrush="#E0DAEC"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center">
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>
                                            <TextBlock Text="{Binding Index, StringFormat='#{0}'}"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       Foreground="#7862B8"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="9"
                                                       Foreground="#605D68"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- Frame Actions Bar (Move Left, Move Right, Remove) -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="MoveFrameUpButton"
                                AutomationProperties.AutomationId="MoveFrameUpButton"
                                Command="{Binding MoveFrameUpCommand}"
                                Content="◀ Lên trước"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Background="#F0EEF8"
                                Foreground="#7862B8"
                                BorderBrush="{StaticResource LavenderAccentBorderBrush}"
                                BorderThickness="1"
                                FontSize="11"
                                Cursor="Hand" />

                        <Button x:Name="MoveFrameDownButton"
                                AutomationProperties.AutomationId="MoveFrameDownButton"
                                Command="{Binding MoveFrameDownCommand}"
                                Content="Xuống sau ▶"
                                Padding="10,4"
                                Margin="0,0,10,0"
                                Background="#F0EEF8"
                                Foreground="#7862B8"
                                BorderBrush="{StaticResource LavenderAccentBorderBrush}"
                                BorderThickness="1"
                                FontSize="11"
                                Cursor="Hand" />

                        <Button x:Name="RemoveFrameButton"
                                AutomationProperties.AutomationId="RemoveFrameButton"
                                Command="{Binding RemoveFrameCommand}"
                                Content="🗑 Xóa frame"
                                Padding="10,4"
                                Background="Transparent"
                                Foreground="#BA1A1A"
                                BorderBrush="#FFCDD2"
                                BorderThickness="1"
                                FontSize="11"
                                Cursor="Hand" />
                    </StackPanel>

                    <!-- Action FPS Slider & Error Display -->
                    <StackPanel Grid.Row="4">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Tốc độ khung hình (FPS)" FontSize="12" Foreground="#49454F" />
                            <TextBlock Text="{Binding CurrentFps, StringFormat='{}{0} FPS'}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource LavenderAccentBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="FpsSlider"
                                AutomationProperties.AutomationId="FpsSlider"
                                Minimum="1" Maximum="60"
                                Value="{Binding CurrentFps, Mode=TwoWay}"
                                Margin="0,0,0,8" />

                        <!-- Error Message if any -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#BA1A1A"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column 1: Preview & Save Actions -->
            <Border Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="#E8E4F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="XEM TRƯỚC ANIMATION"
                               Style="{StaticResource AppSubheaderTextStyle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#7862B8"
                               Margin="0,0,0,10" />

                    <!-- Preview Box -->
                    <Border Grid.Row="1"
                            Background="#F6F4FA"
                            BorderBrush="#E4DEF0"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <controls:SpritePreview x:Name="EditorPreview" />
                    </Border>

                    <!-- Preview Controls (Flip & Play/Pause) -->
                    <Grid Grid.Row="2" Margin="0,8,0,16">
                        <CheckBox x:Name="FlipPreviewCheckBox"
                                  AutomationProperties.AutomationId="FlipPreviewCheckBox"
                                  Content="Lật ngang (Flip X)"
                                  IsChecked="{Binding IsPreviewFlipped, Mode=TwoWay}"
                                  FontSize="11"
                                  VerticalAlignment="Center" />

                        <Button x:Name="TogglePlayPreviewButton"
                                AutomationProperties.AutomationId="TogglePlayPreviewButton"
                                Command="{Binding TogglePlayPreviewCommand}"
                                Content="{Binding IsPreviewPlaying, Converter={StaticResource PlayPauseTextConverter}, FallbackValue='Tạm dừng'}"
                                Padding="8,3"
                                FontSize="10"
                                Background="#F0EEF8"
                                Foreground="#7862B8"
                                BorderBrush="{StaticResource LavenderAccentBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Save & Cancel Buttons -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="{Binding ValidationSummary}"
                                   Foreground="#BA1A1A"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <Button x:Name="SaveAndActivateButton"
                                AutomationProperties.AutomationId="SaveAndActivateButton"
                                Command="{Binding SaveAndActivateCommand}"
                                Content="Lưu và thả ra desktop"
                                Style="{StaticResource LavenderPrimaryButtonStyle}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch" />

                        <Button x:Name="SaveButton"
                                AutomationProperties.AutomationId="SaveButton"
                                Command="{Binding SaveCommand}"
                                Content="Lưu gói pet"
                                Padding="12,7"
                                Margin="0,0,0,8"
                                Background="#F0EEF8"
                                Foreground="#7862B8"
                                BorderBrush="{StaticResource LavenderAccentBorderBrush}"
                                BorderThickness="1"
                                FontWeight="Medium"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand" />

                        <Button x:Name="CancelButton"
                                AutomationProperties.AutomationId="CancelButton"
                                Command="{Binding CancelCommand}"
                                Content="Hủy"
                                Padding="12,5"
                                Background="Transparent"
                                Foreground="#605D68"
                                BorderBrush="#E8E4F0"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
